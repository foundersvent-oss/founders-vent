{
  "name": "founders-vent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founders-vent-db",
      "database_id": "5d04fd70-f682-4868-a373-ec6e4471b0e2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "founders-vent-assets"
    }
  ]
}
